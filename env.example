# Korp Auth Service Configuration
# Copy this file to .env and adjust the values for your environment

# Server Configuration
# Path to Unix socket where the Express server will listen
SOCKET_PATH=/var/run/korp-auth/korp-auth.sock

# Directory for authentication data (JWT keys, database, etc.)
AUTH_DIR=/etc/korp-auth

# Security Configuration
# Path to JWT private key (PEM format)
JWT_PRIVATE_KEY_PATH=/etc/korp-auth/private_key.pem

# API key for Mink service integration
MINK_API_KEY=your-api-key-here

# Database Configuration
# Path to SQLite database file
DB_PATH=/etc/korp-auth/resources.sqlite3

# Application Configuration
# Node environment (development, production)
NODE_ENV=production

# Cookie name for authentication token
# AUTH_COOKIE_NAME=kp-future-auth-token

# Fallback redirect URI after login
# FALLBACK_REDIRECT_URI=https://www.kielipankki.fi

# Authentication Mode
# Set to 'local' for development with demo users, 'oidc' for production
AUTH_MODE=local

# Session Configuration
# Session secret for signing session cookies (generate a random string in production!)
SESSION_SECRET=your-random-secret-here-change-in-production

# Session cookie name
# SESSION_COOKIE_NAME=korp-auth-session

# Session max age in milliseconds (default: 86400000 = 24 hours)
# SESSION_MAX_AGE=86400000

# Redis Configuration (required for OIDC mode)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_KEY_PREFIX=korp-auth:sess:

# OIDC Configuration (Kielipankki AAI)
# Required when AUTH_MODE=oidc

# OIDC provider URL
OIDC_ISSUER_URL=https://aai.kielipankki.fi

# Client credentials (obtain from IdP registration)
OIDC_CLIENT_ID=your-client-id-here
OIDC_CLIENT_SECRET=your-client-secret-here

# Callback URL (must match registered redirect_uri at IdP)
# Example: https://your-domain.fi/auth/callback
OIDC_REDIRECT_URI=https://your-domain.fi/auth/callback

# Scopes to request (space-separated)
# OIDC_SCOPE=openid profile email

# Post-logout redirect URI
# OIDC_POST_LOGOUT_REDIRECT_URI=https://your-domain.fi

# Back-channel logout webhook URI (for logout notifications from IdP)
# OIDC_BACKCHANNEL_LOGOUT_URI=https://your-domain.fi/auth/logout/backchannel

# Enable dynamic client registration (optional)
# OIDC_DYNAMIC_REGISTRATION=false
