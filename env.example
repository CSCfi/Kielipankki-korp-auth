# Korp Auth Service Configuration
# Copy this file to .env and adjust the values for your environment

# ============================================================================
# Server Configuration
# ============================================================================

# Path to Unix socket where the Express server will listen
SOCKET_PATH=/var/run/korp-auth/korp-auth.sock

# Directory for authentication data (JWT keys, database, etc.)
AUTH_DIR=/etc/korp-auth

# ============================================================================
# Security Configuration
# ============================================================================

# Path to JWT private key (PEM format)
# Generate with: openssl genrsa -out private_key.pem 2048
JWT_PRIVATE_KEY_PATH=/etc/korp-auth/private_key.pem

# API key for Mink service integration (resource deletion endpoint)
MINK_API_KEY=your-api-key-here

# ============================================================================
# Database Configuration
# ============================================================================

# Path to SQLite database file
DB_PATH=/etc/korp-auth/resources.sqlite3

# ============================================================================
# Application Configuration
# ============================================================================

# Node environment (development, production)
NODE_ENV=production

# Authentication Mode
# - 'local': Development mode with demo users and login page
# - 'proxy': Production mode, reads user identity from Apache headers
AUTH_MODE=proxy

# ============================================================================
# Development Mode Configuration (AUTH_MODE=local only)
# ============================================================================

# Cookie name for authentication token (used in local dev mode only)
# AUTH_COOKIE_NAME=kp-future-auth-token

# Fallback redirect URI after login (used in local dev mode only)
# FALLBACK_REDIRECT_URI=https://www.kielipankki.fi
